local function elevate()
    pcall(function()
        local fn = setthreadidentity or setidentity or setthreadcontext
        if fn then fn(2) return end
        if syn and syn.set_thread_identity then syn.set_thread_identity(2) return end
        if getgenv then
            local g = getgenv()
            local gf = g.setthreadidentity or g.setidentity
            if gf then gf(2) end
        end
    end)
end
elevate()

local function later(t, f) return task.delay(t, function(...) elevate() return f(...) end) end
local function async(f)    task.spawn(function() elevate() f() end) end

