--  Never let our fake pets stack together in the backpack (unique hash each)
-- =====================================================================
do
    local HashHelper = pload("BackpackItemStackHashHelper")
    if HashHelper and HashHelper.get_item_data_hash and not HashHelper._petSpawnerHashHooked then
        HashHelper._petSpawnerHashHooked = true
        local orig = HashHelper.get_item_data_hash
        HashHelper.get_item_data_hash = function(item, ...)
            if item and item.unique and isFake(item) then
                return tostring(item.category) .. tostring(item.id) .. ":petspawner:" .. tostring(item.unique)
            end
            return orig(item, ...)
        end
