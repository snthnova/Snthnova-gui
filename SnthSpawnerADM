-- =====================================================================
--  State
-- =====================================================================
local FAKE_PREFIX = "petspawner_"
local Pets        = {}     -- [unique] = record { unique, kind, item, props, model, wrapper, equipped, mounted }
local LastEquip   = nil
local MountedRec  = nil
local ModelCache  = {}     -- [kind] = downloaded template (not parented)
local RideAnimTrack = nil
local _fakeCounter  = 0
local _newness      = 900000

-- Ride/fly state ids from the game's MountController / StateManagerClient
local RIDE = { key = "ride", player = "PlayerRidingPet", pet = "PetBeingRidden" }
local FLY  = { key = "fly",  player = "PlayerFlyingPet",  pet = "PetBeingFlown"  }

local function isFake(item)
    return item and type(item.unique) == "string"
        and item.unique:sub(1, #FAKE_PREFIX) == FAKE_PREFIX
end

local function findIndex(list, pred)
    for i, v in pairs(list) do if pred(v, i) then return i end end
    return nil
end

-- =====================================================================
--  Pet-kind resolution (accept a real kind key OR a display name)
-- =====================================================================
local function resolveKind(input)
    if not input or input == "" then return nil end
    input = tostring(input)
    if rawget(InventoryDB.pets, input) then return input end
    local lc = input:lower()
    local normalized = lc:gsub("%s+", "_")
    if rawget(InventoryDB.pets, normalized) then return normalized end
    for kind, entry in pairs(InventoryDB.pets) do
        if type(entry) == "table" and entry.name and entry.name:lower() == lc
           and not entry.is_egg then
            return kind
        end
    end
    return nil
end

-- =====================================================================
--  ClientData helpers (elevated predict; clone lists so real pets are safe)
-- =====================================================================
-- Push a wrapper into "pet_char_wrappers" -> PetEntityService auto-creates the
-- entity, follow, nametag, mega animator AND the native tap interaction.
local function addWrapper(w)
    elevate()
    local list = table.clone(ClientData.get("pet_char_wrappers") or {})
    w.unique = #list + 1
    w.index  = #list + 1
    list[#list + 1] = w
    ClientData.predict("pet_char_wrappers", list)
end

local function removeWrapper(uid)
    elevate()
    local list = table.clone(ClientData.get("pet_char_wrappers") or {})
    local i = findIndex(list, function(w) return w.pet_unique == uid end)
    if i then
        table.remove(list, i)
        for j, w in pairs(list) do w.unique = j; w.index = j end
        ClientData.predict("pet_char_wrappers", list)
    end
end

local function addState(s)
    elevate()
    local list = table.clone(ClientData.get("pet_state_managers") or {})
    list[#list + 1] = s
    ClientData.predict("pet_state_managers", list)
end

local function removeState(model)
    elevate()
    local list = table.clone(ClientData.get("pet_state_managers") or {})
    local i = findIndex(list, function(s) return s.char == model end)
    if i then table.remove(list, i); ClientData.predict("pet_state_managers", list) end
end

-- Flip the pet's state (PetBeingRidden / PetBeingFlown / clear)
local function setPetState(model, stateId)
    elevate()
    local list = table.clone(ClientData.get("pet_state_managers") or {})
    local i = findIndex(list, function(s) return s.char == model end)
    if i then
        list[i] = table.clone(list[i])
        list[i].states = stateId and { { id = stateId } } or {}
        list[i].is_sitting = stateId ~= nil
        ClientData.predict("pet_state_managers", list)
    end
end

-- Flip the local player's own state (PlayerRidingPet / PlayerFlyingPet / clear)
local function setPlayerState(stateId)
    elevate()
    local sm = ClientData.get("state_manager")
    if not sm then return end
    sm = table.clone(sm)
    sm.states = stateId and { { id = stateId } } or {}
    sm.is_sitting = stateId ~= nil
    ClientData.predict("state_manager", sm)
end

-- equip_manager entry -> backpack "equipped" green border
local function setEquippedFlag(item, equipped)
    elevate()
    local em = ClientData.get("equip_manager") or {}
    em.pets = em.pets or {}
    for i = #em.pets, 1, -1 do
        if em.pets[i].unique == item.unique then table.remove(em.pets, i) end
    end
    if equipped then table.insert(em.pets, item) end
    ClientData.predict("equip_manager", em)
    ClientData.update("equip_manager", em)
    -- The equip_manager change refreshes the render but NOT the equipped cache used
    -- to build the buttons (only rebuilt on backpack open). Recalc + refresh so an
    -- unequipped pet's "equipped" border actually clears.
    pcall(function()
        local BCB = pload("BackpackCategoryButtons")
        if BCB and BCB.recalculate_equipped_cache then BCB.recalculate_equipped_cache() end
        local UIManager = load("UIManager")
        local bp = UIManager.apps and UIManager.apps.BackpackApp
        if bp and bp.refresh_rendered_items then bp:refresh_rendered_items() end
    end)
end

local function refreshBackpack()
    later(0, function()
        pcall(function()
            local UIManager = load("UIManager")
            if UIManager.apps and UIManager.apps.BackpackApp then
                UIManager.apps.BackpackApp:refresh_rendered_items()
            end
        end)
    end)
end

-- =====================================================================
--  Backpack: add a pet item to the inventory (does NOT spawn it yet)
-- =====================================================================
local function add(kind, props)
    local resolved = resolveKind(kind)
    if not resolved then log("unknown pet: " .. tostring(kind)); return nil end
    kind = resolved
    props = props or {}
    if props.mega_neon then props.neon = false end

    _fakeCounter += 1
    _newness -= 1
    local item = {
        category = "pets",
        id = kind,
        kind = kind,
        unique = FAKE_PREFIX .. _fakeCounter,
        newness_order = _newness,
        properties = {
            age = math.clamp(props.age or 6, 1, 6),
            friendship_level = props.friendship_level or 0,
            neon = props.neon or false,
            mega_neon = props.mega_neon or false,
            flyable = props.flyable ~= false,
            rideable = props.rideable ~= false,
        },
    }

    elevate()
    local inv = ClientData.get("inventory") or {}
    inv.pets = inv.pets or {}
    inv.pets[item.unique] = item
    ClientData.update("inventory", inv)

    local rec = { unique = item.unique, kind = kind, item = item, props = item.properties,
                  model = nil, wrapper = nil, equipped = false, mounted = nil }
    Pets[item.unique] = rec
    refreshBackpack()
    log("added " .. kind .. " to backpack")
    return rec
end

-- =====================================================================
--  Neon (mega colour cycling is automatic via the entity's MegaNeonAnimator;
--  this sets the neon Material/Color base so the geometry actually glows)
-- =====================================================================
local function applyNeon(model, entry, props)
    if not (PetNeonHelper and (props.neon or props.mega_neon)) then return end
    local pm = model:FindFirstChild("PetModel")
    if not (pm and entry) then return end
    -- megas paint from mega_neon_parts (the MegaNeonAnimator then cycles those
    -- same parts); plain neons use neon_parts.
    local parts = (props.mega_neon and entry.mega_neon_parts) or entry.neon_parts
    if parts then pcall(PetNeonHelper.apply_neon, pm, parts) end
end

-- Our pets' char wrappers must carry the player's REAL location. Systems read
-- it live off the wrapper table (CharWrapperClient hands out the very table we
-- push into pet_char_wrappers): during a neon fusion the cave installs a
-- CharacterHider callback that hides every char whose location isn't the Cave,
-- so a hardcoded "housing" here makes the fused pet invisible for the whole
-- in-bubble reveal.
local function currentLocation()
    local ok, loc = pcall(function()
        local CWC = pload("CharWrapperClient")
        local w = CWC and CWC.get(LocalPlayer.Character)
        return w and w.location
    end)
    if ok and loc then return loc end
    local ok2, loc2 = pcall(function()
        local InteriorsM = pload("InteriorsM")
        return InteriorsM and InteriorsM.get_current_location()
    end)
    if ok2 and loc2 then return loc2 end
    return { full_destination_id = "housing", destination_id = "housing", house_owner = LocalPlayer }
end

local function refreshWrapperLocations()
    local loc = currentLocation()
    for _, rec in pairs(Pets) do
        if rec.wrapper then rec.wrapper.location = loc end
    end
    pcall(function() load("CharacterHider").refresh_all_chars() end)
end

async(function()
    local InteriorsM = pload("InteriorsM")
    local sig = InteriorsM and InteriorsM.on_location_changed
    if sig then
        pcall(function()
            sig:Connect(function() later(0.15, refreshWrapperLocations) end)
        end)
    end
end)

-- The cave grabs the pet entity immediately after ToolAPI/Equip returns
-- (get_pet_entity -> AnchorInPlace + sit animation keeps the fused pet floating
-- inside the bubble). PetEntityService builds ours a frame or two after the
-- wrapper lands, so hold the "server" call until the entity exists.
local function waitForEntity(rec, timeout)
    if not (rec and rec.model) then return nil end
    local PEM = pload("PetEntityManager")
    if not PEM then return nil end
    local deadline = os.clock() + (timeout or 3)
    repeat
        local entity = PEM.get_pet_entity(rec.model)
        if entity then return entity end
        task.wait()
    until os.clock() > deadline
    return nil
end

local function fetchTemplate(kind)
    if ModelCache[kind] then return ModelCache[kind] end
    local template = DownloadClient.promise_download_copy("Pets", kind):expect()
    ModelCache[kind] = template
    return template
end

-- =====================================================================
--  Ride / Fly (the game's real MountController) + Dismount
-- =====================================================================
local function attachStateConnection(model)
    local char = LocalPlayer.Character
    if not (char and char.PrimaryPart) then return false end
    local ridePos = model:FindFirstChild("RidePosition", true)
                 or model:FindFirstChild("HumanoidRootPart", true)
    local rootAtt = char.PrimaryPart:FindFirstChild("RootAttachment")
    if not (ridePos and rootAtt) then return false end
    local att = Instance.new("Attachment")
    att.Name = "SpawnerRideAttachment"
    att.Position = Vector3.new(0, 1.237, 0)
    att.Parent = ridePos
    local rc = Instance.new("RigidConstraint")
    rc.Name = "StateConnection"
    rc.Attachment0 = att
    rc.Attachment1 = rootAtt
    rc.Parent = char
    return true
end

local function clearStateConnection(model)
    local char = LocalPlayer.Character
    if char then
        local sc = char:FindFirstChild("StateConnection")
        if sc then sc:Destroy() end
    end
    if model then
        local att = model:FindFirstChild("SpawnerRideAttachment", true)
        if att then att:Destroy() end
    end
end

local function dismount()
    if not MountedRec then return end
    local rec = MountedRec
    MountedRec = nil
    rec.mounted = nil

    if RideAnimTrack then
        pcall(function() RideAnimTrack:Stop(); RideAnimTrack:Destroy() end)
        RideAnimTrack = nil
    end
    clearStateConnection(rec.model)
    setPetState(rec.model, nil)     -- MountController sees NotMounted -> tears down its movers
    setPlayerState(nil)

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Sit = false; hum.PlatformStand = false end
        if char.PrimaryPart then char.PrimaryPart.Anchored = false end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p:GetAttribute("SpawnerHadMass") then
                p.Massless = false
                p:SetAttribute("SpawnerHadMass", nil)
            end
        end
    end
    pcall(function() rec.model:ScaleTo(1) end)
    log("dismounted")
end

local function mount(rec, mode)
    if type(rec) == "string" then rec = Pets[rec] end
    rec = rec or LastEquip
    if not (rec and rec.model) then log("no pet to mount"); return false end
    local char = LocalPlayer.Character
    if not (char and char.PrimaryPart and char:FindFirstChildOfClass("Humanoid")) then
        log("your character isn't ready"); return false
    end

    dismount()
    MountedRec = rec
    rec.mounted = mode.key

    setPetState(rec.model, mode.pet)
    setPlayerState(mode.player)
    pcall(function() rec.model:ScaleTo(2) end)
    attachStateConnection(rec.model)

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Sit = true end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and not p.Massless then
            p.Massless = true
            p:SetAttribute("SpawnerHadMass", true)
        end
    end
    if AnimationManager and hum then
        pcall(function()
            local animator = hum:FindFirstChildOfClass("Animator")
            local track = AnimationManager.get_track and AnimationManager.get_track("PlayerRidingPet")
            if animator and track then RideAnimTrack = animator:LoadAnimation(track); RideAnimTrack:Play() end
        end)
    end
    log(mode.key == "fly" and "flying" or "riding")
    return true
end

local function ride(rec) return mount(rec, RIDE) end
local function fly(rec)  return mount(rec, FLY)  end

-- toggle for the native ride/fly buttons: requesting the same mount again = dismount
local function toggleMount(rec, mode)
    if MountedRec == rec and rec.mounted == mode.key then dismount(); return true end
    return mount(rec, mode)
end

-- =====================================================================
--  Equip / Unequip  (equip = register via ClientData so the game auto-detects)
-- =====================================================================
-- Placement for a pet the game spawns at a spot of its own (the cave's bubble).
-- The game's pet placement is pivot/root based -- the cave's own pedestal code
-- does PivotTo(spot * CFrame.new(0, HipHeight + root.Size.Y/2, 0)), i.e. the
-- model's pivot lands on the HumanoidRootPart -- so we pivot there too.
-- Pitch/roll is dropped first: the cave builds the bubble from the center pet's
-- POSITION only (CFrame.new(cframe.Position)) but hands us its full CFrame as
-- the spawn point, so any tilt in that root would slide the pet up to 10 studs
-- sideways out of the bubble.
local FusionOffset = Vector3.zero   -- live nudge: PetSpawner.set_fusion_offset(...)

local function placeAtSpawnCFrame(model, cf)
    local pos  = cf.Position + FusionOffset
    local look = cf.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local target = (flat.Magnitude > 1e-4) and CFrame.lookAt(pos, pos + flat.Unit) or CFrame.new(pos)
    model:PivotTo(target)

    -- so the exact framing can be checked against the real thing
    pcall(function()
        local boxCF, boxSize = model:GetBoundingBox()
        local toCenter = model:GetPivot():ToObjectSpace(boxCF).Position
        log(("spawned at %s | bbox %s | pivot->center %s"):format(
            tostring(pos), tostring(boxSize), tostring(toCenter)))
    end)
end

local unequip  -- forward decl (equip unequips others: one pet equipped at a time)

local function equip(rec, opts)
    if type(rec) == "string" then rec = Pets[rec] end
    if not rec or rec.model then return rec end
    local char = LocalPlayer.Character
    if not (char and char.PrimaryPart) then log("your character isn't loaded"); return nil end

    -- only one pet equipped at a time: remove any others first
    for _, other in pairs(Pets) do
        if other ~= rec and other.model then unequip(other) end
    end

    local model
    local ok, err = pcall(function() model = fetchTemplate(rec.kind):Clone() end)
    if not ok or not model then log("download failed: " .. tostring(err)); return nil end
    if not model.PrimaryPart then model.PrimaryPart = model:FindFirstChild("HumanoidRootPart") end
    model.Parent = workspace
    if opts and typeof(opts.spawn_cframe) == "CFrame" then
        -- PetEntityService drops every freshly spawned pet onto its owner
        -- (get_teleport_location -> SetPrimaryPartCFrame) UNLESS the char carries
        -- "HasSpawnCFrame" -- the attribute the server sets when a pet is spawned
        -- at a place of its own, which is what keeps the fused pet in the cave's
        -- bubble instead of at your feet. Anchor it too, so it doesn't sag in the
        -- frames before the cave stages AnchorInPlace (CFrameSetter unanchors it
        -- again by itself if that never happens).
        model:SetAttribute("HasSpawnCFrame", true)
        pcall(function()
            placeAtSpawnCFrame(model, opts.spawn_cframe)
            local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = true end
        end)
    end

    rec.model = model
    rec.equipped = true
    applyNeon(model, InventoryDB.pets[rec.kind], rec.props)

    -- Register through ClientData: PetEntityService picks this up and builds the
    -- real entity + native interaction. No manual create_pet_entity / click hook.
    local entry = InventoryDB.pets[rec.kind]
    local trickCount = entry and entry.tricks and #entry.tricks or 0
    task.defer(function()
        elevate()
        local wrapper = {
            char = model,
            neon = rec.props.neon or false,
            mega_neon = rec.props.mega_neon or false,
            temporary = false,
            nametag_hidden = false,
            player = LocalPlayer,
            entity_controller = LocalPlayer,
            controller = LocalPlayer,
            rp_name = rec.props.rp_name or "",
            pet_trick_level = math.max(rec.props.pet_trick_level or 0, trickCount),
            pet_unique = rec.unique,
            pet_id = rec.kind,
            location = currentLocation(),
            pet_progression = {
                age = rec.props.age or 6,
                xp = rec.props.xp or 0,
                friendship_level = rec.props.friendship_level or 0,
                percentage = 0,
            },
            are_colors_sealed = false,
            is_pet = true,
        }
        addWrapper(wrapper)
        rec.wrapper = wrapper
        addState({
            char = model, player = LocalPlayer, store_key = "pet_state_managers",
            is_sitting = false, chars_connected_to_me = {}, states = {},
        })
    end)

    setEquippedFlag(rec.item, true)
    LastEquip = rec
    log("equipped " .. rec.kind .. " -- tap the pet to interact")
    return rec
end

function unequip(rec)
    if type(rec) == "string" then rec = Pets[rec] end
    if not rec or not rec.model then return end
    if MountedRec == rec then dismount() end
    removeWrapper(rec.unique)        -- PetEntityService removes the entity
    removeState(rec.model)
    pcall(function() rec.model:Destroy() end)
    rec.model, rec.wrapper, rec.equipped = nil, nil, false
    setEquippedFlag(rec.item, false)
    if LastEquip == rec then LastEquip = nil end
end

local function despawn(rec)
    if type(rec) == "string" then rec = Pets[rec] end
    if not rec then return end
    unequip(rec)
    elevate()
    local inv = ClientData.get("inventory") or {}
    if inv.pets then inv.pets[rec.unique] = nil; ClientData.update("inventory", inv) end
    Pets[rec.unique] = nil
    refreshBackpack()
end

local function clear()
    for _, rec in pairs(Pets) do unequip(rec) end
    elevate()
    local inv = ClientData.get("inventory") or {}
    if inv.pets then
        for unique in pairs(Pets) do inv.pets[unique] = nil end
        ClientData.update("inventory", inv)
    end
    Pets = {}
    LastEquip = nil
    refreshBackpack()
end

local function spawn(kind, props)
    local rec = add(kind, props)
    if rec then equip(rec) end
    return rec
end

