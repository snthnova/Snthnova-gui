-- =====================================================================
--  Trade (client-sided): keep our fake pets in YOUR real trade offer.
--  TradeApp._add_item_to_my_offer already drops the picked item into
--  local_trade_state; we suppress the server AddItemToOffer (so it isn't
--  rejected) and RE-INJECT the fake into every _overwrite_local_trade_state so a
--  server sync can't wipe it. Because we inject into the state the game is about
--  to store, its own _on_local_trade_state_changed narrates the add into the
--  trade chat/history and the offer pane renders the pet's icon.
-- =====================================================================
local TradeFakes   = {}    -- [unique] = offer item (fake pets currently in your offer)
local TradeOffers  = {}    -- [trade_id] = { items = <your full offer incl fakes>, isSender } for history
local _lastTradeId = nil

local function reinjectTradeFakes(state)
    if state == nil then TradeFakes = {}; _lastTradeId = nil; return end
    if _lastTradeId ~= nil and state.trade_id ~= _lastTradeId then TradeFakes = {} end  -- new trade
    _lastTradeId = state.trade_id
    local isSender = (state.sender == LocalPlayer)
    local offer = state[isSender and "sender_offer" or "recipient_offer"]
    if not offer then return end
    offer.items = offer.items or {}
    for uid, item in pairs(TradeFakes) do
        local present = false
        for _, it in ipairs(offer.items) do if it.unique == uid then present = true; break end end
        if not present then table.insert(offer.items, item) end
    end
    -- snapshot YOUR offer (real + fake) so the Trade History can show it later
    if next(TradeFakes) and state.trade_id then
        TradeOffers[state.trade_id] = { items = table.clone(offer.items), isSender = isSender }
    end
end

-- Patch the live-trade + trade-history apps (singletons). Safe to call repeatedly.
local function ensureTradeHook()
    pcall(function()
        local apps = load("UIManager").apps
        if not apps then return end
        local app = apps.TradeApp
        if app and not app._petSpawnerTradeHooked then
            app._petSpawnerTradeHooked = true
            local orig = app._overwrite_local_trade_state
            app._overwrite_local_trade_state = function(self, state, ...)
                pcall(reinjectTradeFakes, state)   -- mutate before it's deep-copied + narrated
                return orig(self, state, ...)
            end
        end
        -- Trade History: inject your snapshotted offer (with fakes) into the record frame
        local hist = apps.TradeHistoryApp
        if hist and hist._create_trade_frame and not hist._petSpawnerHistHooked then
            hist._petSpawnerHistHooked = true
            local origFrame = hist._create_trade_frame
            hist._create_trade_frame = function(self, tradeData, ...)
                local snap = tradeData and tradeData.trade_id and TradeOffers[tradeData.trade_id]
                if snap then
                    local modified = table.clone(tradeData)
                    if snap.isSender then modified.sender_items = table.clone(snap.items)
                    else modified.recipient_items = table.clone(snap.items) end
                    return origFrame(self, modified, ...)
                end
                return origFrame(self, tradeData, ...)
            end
        end
    end)
end
ensureTradeHook()  -- hook now if the apps already exist

-- =====================================================================
--  Neon Cave: fuse spawned pets on the REAL cave pedestals
--  The cave's own code (ContentPacks/NeonRefresh2025/Interiors -> "Cave")
--  already drives the entire show for us: Place Pet / Remove Pet prompts, the
--  per-pet NeonPetPlace / MegaNeonPetPlace sounds, the 4 stacking NeonMusicLoop
--  layers, the dummy pet walking onto PetTarget, then on the 4th pet
--  merge_pets -> NeonVFXHelper.play_vfx (pet spinners + trails, bubbles,
--  colour-bubble spinners, light shafts, final boom / mega galaxy, camera shake
--  and ceiling rubble) and finally the fused pet spawning in and sitting.
--  The ONLY part of that flow a client-only pet can't do is the server call
--  that mints the fused pet, so we answer PetAPI/DoNeonFusion ourselves and
--  hand back a fake unique -- everything else is the game's own code, 1:1.
-- =====================================================================
local FusionNewborn  = false   -- true = like the real game (fused pet is a newborn)
local PEDESTAL_COUNT = 8       -- Cave.DisplayedPets slots (the "recently fused" statues)

-- Answers RouterClient "PetAPI/DoNeonFusion" for our pets.
-- Returns unique, kind (what the real endpoint returns) or nil to fall through.
local function doNeonFusion(uniques)
    local recs, first = {}, nil
    for _, uid in ipairs(uniques) do
        local rec = Pets[uid]
        if rec then
            recs[#recs + 1] = rec
            first = first or rec
        end
    end
    if not first then return nil end      -- only real pets placed: let the server answer

    -- 4 plain pets -> neon, 4 neons -> mega neon (the cave already enforces
    -- "same species, same type, fully grown, not mega" when placing).
    local mega = first.props.neon and true or false
    local result = add(first.kind, {
        age              = FusionNewborn and 1 or 6,
        neon             = not mega,
        mega_neon        = mega,
        flyable          = first.props.flyable,
        rideable         = first.props.rideable,
        friendship_level = first.props.friendship_level,
    })
    if not result then return nil end

    for _, rec in ipairs(recs) do despawn(rec) end   -- the placed pets are consumed

    -- the statues around the cave show your recent fusions; predicting
    -- recently_fused makes the cave's own render callback poof ours in
    pcall(function()
        elevate()
        local rf = table.clone(ClientData.get("recently_fused") or {})
        rf.pets = table.clone(rf.pets or {})
        local idx = ((rf.index or 0) % PEDESTAL_COUNT) + 1
        rf.pets[idx] = { kind = result.kind, mega = mega }
        rf.index = idx
        ClientData.predict("recently_fused", rf)
    end)

    log("fused " .. (mega and "mega neon " or "neon ") .. result.kind)
    return result.unique, result.kind
end

-- Drop 4 identical fusion-ready pets in the backpack (what the cave wants):
-- fully grown, not mega, and neon only when you're going for a mega neon.
local function fuseSet(kind, props)
    local resolved = resolveKind(kind)
    if not resolved then log("unknown pet: " .. tostring(kind)); return nil end
    props = table.clone(props or {})
    props.age = 6
    props.neon = props.mega_neon and true or props.neon or false
    props.mega_neon = false
    local made = {}
    for _ = 1, 4 do made[#made + 1] = add(resolved, props) end
    log("added 4 " .. (props.neon and "neon " or "") .. resolved .. " -- place them on the cave spots")
    return made
end

-- =====================================================================
--  Router hooks: redirect our client-only pets' server remotes locally
-- =====================================================================
if not RouterClient._petSpawnerHooked_v2 then
    RouterClient._petSpawnerHooked_v2 = true
    local realGet = RouterClient.get
    function RouterClient.get(endpoint)
        if endpoint == "ToolAPI/Equip" then
            return { InvokeServer = function(_, uid, meta)
                local rec = Pets[uid]
                if rec then
                    elevate()
                    equip(rec, meta)
                    waitForEntity(rec)
                    return true, { action = "equip", is_server = true }
                end
                return realGet("ToolAPI/Equip"):InvokeServer(uid, meta)
            end }
        elseif endpoint == "ToolAPI/Unequip" then
            return { InvokeServer = function(_, uid)
                local rec = Pets[uid]
                if rec then elevate(); unequip(rec); return true, { action = "unequip", is_server = true } end
                return realGet("ToolAPI/Unequip"):InvokeServer(uid)
            end }
        elseif endpoint == "AdoptAPI/RidePet" then
            return { InvokeServer = function(_, wrapper)
                local rec = wrapper and Pets[wrapper.pet_unique]
                if rec then elevate(); toggleMount(rec, RIDE); return true end
                return realGet("AdoptAPI/RidePet"):InvokeServer(wrapper)
            end }
        elseif endpoint == "AdoptAPI/FlyPet" then
            return { InvokeServer = function(_, wrapper)
                local rec = wrapper and Pets[wrapper.pet_unique]
                if rec then elevate(); toggleMount(rec, FLY); return true end
                return realGet("AdoptAPI/FlyPet"):InvokeServer(wrapper)
            end }
        elseif endpoint == "PetAPI/DoNeonFusion" then
            return { InvokeServer = function(_, uniques)
                elevate()
                local unique, kind = doNeonFusion(uniques or {})
                if unique then return unique, kind end
                return realGet("PetAPI/DoNeonFusion"):InvokeServer(uniques)
            end }
        elseif endpoint == "TradeAPI/AddItemToOffer" then
            -- Our fake pets ARE selectable in the trade picker (real inventory
            -- items with a real kind). Record the pet + arm the re-inject hook,
            -- and suppress the server call so it isn't rejected. The pet stays in
            -- YOUR offer (client-side) across server syncs and shows in history.
            return { FireServer = function(_, uid)
                local rec = Pets[uid]
                if rec then ensureTradeHook(); TradeFakes[uid] = rec.item; return end
                return realGet("TradeAPI/AddItemToOffer"):FireServer(uid)
            end }
        elseif endpoint == "TradeAPI/RemoveItemFromOffer" then
            return { FireServer = function(_, uid)
                if Pets[uid] then TradeFakes[uid] = nil; return end
                return realGet("TradeAPI/RemoveItemFromOffer"):FireServer(uid)
            end }
        elseif endpoint == "AdoptAPI/ExitSeatStates" then
            return { FireServer = function()
                if MountedRec then elevate(); dismount(); return end
                return realGet("AdoptAPI/ExitSeatStates"):FireServer()
            end }
        elseif endpoint == "AdoptAPI/ExitSeatStatesYield" then
            return { InvokeServer = function()
                if MountedRec then elevate(); dismount(); return true end
                return realGet("AdoptAPI/ExitSeatStatesYield"):InvokeServer()
            end }
        end
        return realGet(endpoint)
    end
end

-- =====================================================================
--  Tricks: let the native "Tricks" interaction play tricks on spawned pets
--  (PetActions.do_trick normally needs the server; we play it client-side)
-- =====================================================================
task.spawn(function()
    elevate()
    pcall(function()
        local PA  = load("PetActions")
        local AM  = load("AnimationManager")
        local PEM = load("PetEntityManager")
        local UIM = load("UIManager")
        local IDB = load("InventoryDB")
        if not (PA and PA.do_trick) or PA._petSpawnerTrickHooked then return end
        PA._petSpawnerTrickHooked = true
        local origDoTrick = PA.do_trick
        PA.do_trick = function(wrapper)
            local rec = wrapper and Pets[wrapper.pet_unique]
            if not rec then return origDoTrick(wrapper) end
            local entry = IDB.pets[wrapper.pet_id]
            if not entry or not entry.tricks or #entry.tricks == 0 then return end

            local buttons = {}
            for i, trick in ipairs(entry.tricks) do
                if (wrapper.pet_trick_level or 0) < i then
                    buttons[i] = { layout_order = i, text = "???", button_state = "inactive" }
                else
                    buttons[i] = { layout_order = i, text = trick[1] }
                end
            end

            task.spawn(function()
                elevate()
                local chosen = UIM.apps.DialogApp:dialog({
                    dialog_type = "ScrollingButtonsDialog", header = "SELECT TRICK",
                    buttons = buttons, exit_button = true, cells_per_row = 2, padding = 10,
                })
                if not chosen or chosen == "cancel" then return end
                local te = entry.tricks[chosen]; if not te then return end
                local trickName, animKey = te[1], te[2] or te[1]
                local char = wrapper.char
                local pm = char:FindFirstChild("PetModel")
                local ac = pm and pm:FindFirstChildOfClass("AnimationController")
                local animator = (ac and ac:FindFirstChildOfClass("Animator"))
                    or char:FindFirstChildWhichIsA("Animator", true)
                if not animator then return end
                local at = AM.get_track(animKey) or AM.get_track(trickName)
                if not at then return end

                pcall(function() origDoTrick(wrapper) end)  -- windup on server (harmless for our pet)
                task.wait(3)
                pcall(function() UIM.apps.FocusPetApp:release_focus() end)
                pcall(function()
                    if rec._activeTrickTrack then
                        pcall(function() rec._activeTrickTrack:Stop(0.1) end)
                        rec._activeTrickTrack = nil
                    end
                    local track = animator:LoadAnimation(at)
                    track:Play()
                    rec._activeTrickTrack = track
                    task.spawn(function()
                        local t = 0
                        while t < 15 do
                            task.wait(0.1); t += 0.1
                            if not track.IsPlaying then break end
                            local entity = PEM and PEM.get_pet_entity(char)
                            if entity and entity.move_state and entity.move_state.is_moving then
                                track:Stop(0.2); break
                            end
                        end
                        rec._activeTrickTrack = nil
                    end)
                end)
            end)
        end
    end)
end)

